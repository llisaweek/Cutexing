rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string &&
        data.email is string &&
        (!('googlePhotoUrl' in data) || data.googlePhotoUrl is string) &&
        (!('customAvatarUrl' in data) || data.customAvatarUrl is string) &&
        (!('avatarStoragePath' in data) || data.avatarStoragePath is string) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNote(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.title is string &&
        data.content is string &&
        data.color is string &&
        data.isPinned is bool &&
        data.isArchived is bool &&
        data.isDeleted is bool &&
        data.labels is list &&
        data.checklist is list &&
        (!('reminder' in data) || data.reminder is string) &&
        (!('drawingUrl' in data) || data.drawingUrl is string) &&
        (!('drawingStoragePath' in data) || data.drawingStoragePath is string) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidNote(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
